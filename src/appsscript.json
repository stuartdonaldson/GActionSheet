{
  "timeZone": "America/New_York",
  "dependencies": {
    "enabledAdvancedServices": [
      { "userSymbol": "Drive", "serviceId": "drive", "version": "v2" },
      { "userSymbol": "DriveV3", "serviceId": "drive", "version": "v3" },
      { "userSymbol": "AdminDirectory", "serviceId": "admin", "version": "directory_v1" },
      { "userSymbol": "Docs", "serviceId": "docs", "version": "v1" }
    ]
  },
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/drive",
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/documents",
    "https://www.googleapis.com/auth/script.scriptapp",
    "https://www.googleapis.com/auth/script.container.ui",
    "https://www.googleapis.com/auth/script.external_request",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/workspace.linkpreview",
    "https://www.googleapis.com/auth/workspace.linkcreate",
    "https://www.googleapis.com/auth/admin.directory.group.readonly",
    "https://www.googleapis.com/auth/admin.directory.group.member.readonly",
    "openid"
  ],
  "urlFetchWhitelist": [
    "https://script.google.com/a/macros/northlakeuu.org/s/",
    "https://script.google.com/a/northlakeuu.org/macros/s/",
    "https://script.google.com/macros/s/",
    "https://docs.googleapis.com/",
    "https://docs.google.com/document/",
    "https://www.googleapis.com/drive/",
    "https://www.googleapis.com/batch/drive/",
    "https://api.axiom.co/",
    "https://oauth2.googleapis.com/",
    "https://*.googleusercontent.com/"
  ],
  "webapp": {
    "access": "ANYONE_ANONYMOUS",
    "executeAs": "USER_DEPLOYING"
  },
  "addOns": {
    "common": {
      "name": "Northlake UU Tool Suite",
      "logoUrl": "https://stuartdonaldson.github.io/GActionSheet/assets/product-details/northlake-uu-emblem.png",
      "homepageTrigger": {
        "runFunction": "buildHomepageCard"
      },
      "universalActions": [
        {
          "label": "Export JSON",
          "runFunction": "onGovernanceExportMenu"
        },
        {
          "label": "Export JSON + PDF Snapshot",
          "runFunction": "onGovernanceExportAndPdfMenu"
        }
      ]
    },
    "docs": {
      "homepageTrigger": {
        "runFunction": "buildHomepageCard"
      },
      "createActionTriggers": [
        {
          "id": "createAction",
          "runFunction": "createActionTrigger",
          "labelText": "Create action",
          "logoUrl": "https://stuartdonaldson.github.io/GActionSheet/assets/product-details/action-item-logo.png"
        }
      ],
      "linkPreviewTriggers": [
        {
          "labelText": "GActionSheet Action",
          "logoUrl": "https://stuartdonaldson.github.io/GActionSheet/assets/product-details/action-item-logo.png",
          "patterns": [
            {
              "hostPattern": "northlakeuu.org",
              "pathPrefix": "NUUTS"
            }
          ],
          "runFunction": "onLinkPreview"
        }
      ]
    }
  }
}
