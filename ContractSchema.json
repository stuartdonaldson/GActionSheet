{
  "actionItem": {
    "fields": [
      "action_id",
      "assignee_email",
      "action_text",
      "status"
    ]
  },
  "sheetTeamData": {
    "headers": [
      "Team Id",
      "Folder Id",
      "Contact",
      "Team Link"
    ],
    "columnsByField": {
      "team_id": 1,
      "folder_id": 2,
      "contact": 3,
      "team_link": 4
    }
  },
  "sheetDocData": {
    "headers": [
      "FileId",
      "Doc Name",
      "Last Sync Time",
      "Doc Updated",
      "SyncStatus",
      "Team Id",
      "Action Count",
      "Resolved Count"
    ],
    "columnsByField": {
      "file_id": 1,
      "doc_name": 2,
      "last_sync_time": 3,
      "doc_updated": 4,
      "sync_status": 5,
      "team_id": 6,
      "action_count": 7,
      "resolved_count": 8
    }
  },
  "sheetConfig": {
    "headers": [
      "Key",
      "Value"
    ],
    "columnsByField": {
      "key": 1,
      "value": 2
    }
  },
  "sheetExportIndex": {
    "headers": [
      "Doc Id",
      "Doc Title",
      "Folder Id",
      "Created At",
      "Last Exported At",
      "Meta Json"
    ],
    "columnsByField": {
      "doc_id": 1,
      "doc_title": 2,
      "folder_id": 3,
      "created_at": 4,
      "last_exported_at": 5,
      "meta_json": 6
    }
  },
  "sheetAction": {
    "fields": [
      "global_id",
      "file_id",
      "action_id",
      "assignee_email",
      "assignee_name",
      "action_text",
      "status",
      "document_formula",
      "doc_id",
      "doc_name",
      "created_date",
      "modified_date",
      "sync_status",
      "custom_fields"
    ],
    "headers": [
      "globalId",
      "File Id",
      "ID",
      "Assignee Email",
      "Assignee Name",
      "Action",
      "Status",
      "Document",
      "Date Created",
      "Date Modified",
      "Sync Status",
      "Custom Fields"
    ],
    "columnsByField": {
      "global_id": 1,
      "file_id": 2,
      "action_id": 3,
      "assignee_email": 4,
      "assignee_name": 5,
      "action_text": 6,
      "status": 7,
      "document_formula": 8,
      "created_date": 9,
      "modified_date": 10,
      "sync_status": 11,
      "custom_fields": 12
    }
  },
  "webApp": {
    "routeNames": [
      "set_test_token",
      "set_axiom_config",
      "set_export_config",
      "upsert_action_rows",
      "sync_action_rows",
      "verify_action_rows",
      "mark_doc_not_found",
      "delete_action_row",
      "patch_action_status",
      "list_importable_actions",
      "forward_action_rows",
      "run_fixture"
    ],
    "testRouteNames": [
      "edit_action_row",
      "find_sheet_actions",
      "dump_doc_paragraphs",
      "dump_raw_docs_api",
      "read_team_actions",
      "verify_chip_integrity",
      "import_selected_for_test",
      "forward_action_rows_test"
    ],
    "messages": {
      "sync_action_rows": {
        "request": [
          "action",
          "testToken",
          "docId"
        ],
        "response": [
          "ok",
          "sheetWins",
          "docWins",
          "queueDrained"
        ],
        "completionSignal": "synchronous response after ACTION_SHEET_QUEUE drains (§16.11 #4)"
      },
      "edit_action_row": {
        "request": [
          "action",
          "testToken",
          "global_id",
          "fields"
        ],
        "response": [
          "ok",
          "global_id",
          "row"
        ],
        "completionSignal": "synchronous response; row stamped Sync Status='Dirty' + Date Modified"
      },
      "patch_action_status": {
        "request": [
          "action",
          "testToken",
          "global_id",
          "status"
        ],
        "response": [
          "ok",
          "global_id"
        ],
        "completionSignal": "synchronous ack; durable status converges on the next sync_action_rows"
      },
      "delete_action_row": {
        "request": [
          "action",
          "testToken",
          "global_id"
        ],
        "response": [
          "ok",
          "global_id"
        ],
        "completionSignal": "synchronous response; row stamped Sync Status='Deleted'"
      },
      "find_sheet_actions": {
        "request": [
          "action",
          "testToken",
          "docId"
        ],
        "response": [
          "ok",
          "docId",
          "rows"
        ],
        "completionSignal": "synchronous response; rows scoped to docId"
      },
      "list_importable_actions": {
        "request": [
          "action",
          "secret",
          "docId",
          "clientVersion",
          "caller"
        ],
        "response": [
          "ok",
          "teamId",
          "rows"
        ],
        "completionSignal": "synchronous response; rows scoped to current doc's team, excluding current doc"
      },
      "forward_action_rows": {
        "request": [
          "action",
          "secret",
          "forwards",
          "targetDocName",
          "clientVersion",
          "caller"
        ],
        "response": [
          "ok",
          "forwarded"
        ],
        "completionSignal": "synchronous response; source rows stamped Status='Forwarded' + Sync Status='Dirty'"
      },
      "import_selected_for_test": {
        "request": [
          "action",
          "testToken",
          "testDocId",
          "globalIds"
        ],
        "response": [
          "ok",
          "inserted",
          "baseN"
        ],
        "completionSignal": "synchronous response; same as _submitImport's IMPORT_SELECTED.done"
      },
      "read_team_actions": {
        "request": [
          "action",
          "testToken",
          "teamId",
          "docId",
          "statusFilter",
          "windowDays",
          "excludeDocId",
          "assigneeEmail"
        ],
        "response": [
          "ok",
          "teamId",
          "rows",
          "statusOptions"
        ],
        "completionSignal": "synchronous response; rows scoped to teamId under the requested filters"
      },
      "forward_action_rows_test": {
        "request": [
          "action",
          "testToken",
          "forwards",
          "targetDocName"
        ],
        "response": [
          "ok",
          "forwarded"
        ],
        "completionSignal": "synchronous response; same stamping behavior as forward_action_rows"
      }
    }
  },
  "documentRead": {
    "modelNames": [
      "floating_action",
      "tracker_row",
      "verification_sheet_row"
    ]
  }
}